---
import '../styles/global.css';

const team = [
  ['Garapati Sai Aditya', '25BCE2449'],
  ['Shrish Verma', '25BCE2542'],
  ['Sreya Chandrasekharan', '25BCE2606'],
  ['Annette Jose', '25BCE2635'],
  ['Sahila Yazar Pottayil', '25BCE2642'],
];

const timeline = [
  { y: '1970', m: 'June', t: 'Relational model', d: '<b>E. F. Codd</b> at IBM publishes “A Relational Model of Data for Large Shared Data Banks”. Data becomes tables of rows.', pos: 'top', key: true },
  { y: '1974', m: 'IBM', t: 'SEQUEL', d: '<b>Chamberlin and Boyce</b> design SEQUEL, later renamed SQL, to query relational data.', pos: 'bot' },
  { y: '1979', m: 'Market', t: 'Oracle V2', d: 'One of the first <b>commercial SQL databases</b> ships. Relational systems dominate for three decades.', pos: 'top' },
  { y: '1998', m: 'Name', t: '“NoSQL”', d: '<b>Carlo Strozzi</b> uses the name for a lightweight relational database with no SQL interface.', pos: 'bot' },
  { y: '2006', m: 'OSDI', t: 'Bigtable', d: '<b>Google</b> publishes Bigtable: a distributed, wide-column store spread over thousands of machines.', pos: 'top', key: true },
  { y: '2007', m: 'SOSP', t: 'Dynamo', d: '<b>Amazon</b> publishes Dynamo: a key-value store that stays writable even when servers fail.', pos: 'bot', key: true },
  { y: '2008', m: 'Open source', t: 'Cassandra', d: '<b>Facebook</b> open-sources Cassandra, built for inbox search. It mixes Dynamo’s distribution with Bigtable’s data model.', pos: 'top' },
  { y: '2009', m: 'June', t: 'The name sticks', d: '<b>MongoDB</b> and <b>Redis</b> appear. A San Francisco meetup on distributed databases revives the label “NoSQL”.', pos: 'bot', key: true },
  { y: '2012', m: 'Cloud', t: 'DynamoDB', d: '<b>Amazon</b> launches DynamoDB as a fully managed service. NoSQL becomes something you rent.', pos: 'top' },
  { y: '2018', m: 'Convergence', t: 'Lines blur', d: '<b>MongoDB 4.0</b> adds multi-document ACID transactions. Meanwhile SQL databases learn JSON. Not only SQL, in both directions.', pos: 'bot' },
];

const chapters = [
  'Not only SQL', 'Every tap', 'Definition', 'Origins', 'The table', 'The wall', 'Scale lab', 'Rows vs documents',
  'Schema', 'Four families', 'The cluster', 'Consistency', 'SQL vs NoSQL', 'Advantages', 'Limitations',
  'In the wild', 'Choose', 'Polyglot', 'Recap', 'Fin',
];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Not Only SQL</title>
  <meta name="description" content="A scroll-driven, interactive introduction to NoSQL databases by Team 9, BACSE202." />
  <link rel="icon" href="data:," />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Instrument+Serif:ital@0;1&display=swap" />
</head>
<body>
  <canvas id="world" aria-hidden="true"></canvas>
  <div class="vignette" aria-hidden="true"></div>
  <div class="scanline" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>

  <div id="boot" aria-hidden="true">
    <div class="boot-box">
      <div class="boot-count"><span id="boot-n">000</span></div>
      <div class="boot-bar"><i id="boot-bar"></i></div>
      <ol id="boot-log"></ol>
    </div>
  </div>

  <div class="hud-progress" id="hud-progress"></div>
  <div class="hud-bottom" aria-hidden="true"><span></span><span class="pct" id="hud-pct">000%</span></div>
  <nav class="chapter-nav" id="chapter-nav" aria-label="Chapters">
    {chapters.map((c, i) => <button type="button" data-jump={i} aria-label={`Go to ${c}`}><span>{String(i + 1).padStart(2, '0')} {c}</span></button>)}
  </nav>

  <main>
    <!-- 01 HERO -->
    <section class="chapter hero" id="top" data-scene="nebula" data-chapter="Not only SQL">
      <div class="hero-inner">
        <p class="eyebrow">BACSE202 · Database Systems · Module 5 · Seminar</p>
        <h1 class="hero-title">
          <span class="ht-small" data-split>Introduction to</span>
          <span class="ht-big" data-split><span class="q">No</span>SQL</span>
        </h1>
        <div class="hero-row">
          <p class="hero-lede">Why the web outgrew tables, and what we built instead. <em>Scroll slowly.</em> Everything here moves, and most of it answers back.</p>
          <div class="hero-team">
            {team.map(([n, r]) => <div><b>{n}</b><span>{r}</span></div>)}
          </div>
        </div>
        <div class="scroll-cue">Scroll to begin <i></i></div>
      </div>
    </section>

    <!-- 02 PHONE -->
    <section class="chapter phone-ch" id="tap" data-chapter="Every tap" style="padding-inline:0">
      <div class="phone-sticky">
        <div class="phone-title">
          <p class="eyebrow">Why we are here</p>
          <h2 class="h-display">Every tap is<br />a <em>database</em> call.</h2>
        </div>
        <div class="phone-rig">
          <div class="phone" id="phone">
            <div class="phone-screen">
              <div class="phone-island"></div>
              <div class="app-bar"><strong>Pulse</strong><button type="button" data-act="refresh">Refresh feed</button></div>
              <div class="app-feed">
                <article class="post">
                  <div class="post-head"><span class="av" style="background:linear-gradient(135deg,#ff8a1f,#ffcf8a)"></span><b>mira.k</b><span>2m</span><button type="button" class="follow" data-act="follow">Follow</button></div>
                  <div class="post-img" style="background:radial-gradient(circle at 30% 40%,#ffcf8a,#ff8a1f 40%,#3a2a1f 90%)"></div>
                  <div class="post-foot"><button type="button" data-act="like">♥ <span>812</span></button><button type="button" data-act="view">Seen by</button></div>
                </article>
                <article class="post">
                  <div class="post-head"><span class="av" style="background:linear-gradient(135deg,#9fdc8c,#2c4a2a)"></span><b>dev_arjun</b><span>9m</span></div>
                  <div class="post-img" style="background:repeating-linear-gradient(90deg,#1c2229 0 14px,#262d36 14px 28px),linear-gradient(#ff8a1f,#ff8a1f)"></div>
                  <div class="post-foot"><button type="button" data-act="view">12k views</button><span class="price">#hackathon</span></div>
                </article>
                <article class="post">
                  <div class="post-head"><span class="av" style="background:linear-gradient(135deg,#9cc8ff,#2c3e66)"></span><b>fieldkit.store</b><span>Ad</span></div>
                  <div class="post-img" style="background:linear-gradient(160deg,#1c2229,#3c4652 50%,#9cc8ff)"></div>
                  <div class="post-foot"><button type="button" data-act="cart">+ Cart</button><span class="price">₹2,499</span></div>
                </article>
              </div>
              <div class="app-tabbar"><span class="on">Feed</span><span>Search</span><span>Cart</span><span>You</span></div>
            </div>
          </div>
        </div>
        <p class="phone-hint note">Tap the buttons on the phone. Each action is a real query shape a production app would send. Idle for a moment and the app taps itself.</p>
        <aside class="qlog panel" aria-live="polite">
          <div class="panel-head"><span>Query log · live</span><span class="dots"><i></i><i></i><i></i></span></div>
          <div class="panel-body"><ol id="qlog"></ol></div>
        </aside>
      </div>
    </section>

    <!-- 03 DEFINITION -->
    <section class="chapter def" id="definition" data-chapter="Definition">
      <div class="def-pin" id="def-pin">
        <div class="def-word" aria-label="NoSQL means not only SQL">
          <span class="w w1">NoSQL</span>
          <span class="w w2"><s>No SQL</s></span>
          <span class="w w3"><span class="sm">Not only</span>SQL</span>
        </div>
        <p class="def-cap" id="def-cap">The name first read as a refusal. It grew into an invitation.</p>
      </div>
      <div class="def-read">
        <p class="eyebrow">Definition</p>
        <p class="def-para" id="def-para">A <span class="hl">NoSQL database</span> stores data in models other than the tables of a relational system: <span class="hl2">key–value pairs, documents, wide columns or graphs</span>. Most are built to spread data across many ordinary servers, and many trade strict consistency for speed and availability. Today the name means <span class="hl">not only SQL</span>: several NoSQL systems even speak SQL-like languages of their own.</p>
        <div class="def-facts">
          <div><span class="big">2009</span><p>The year the label caught on, after a meetup on open-source distributed databases.</p></div>
          <div><span class="big">4</span><p>Main data models: key-value, document, wide-column and graph.</p></div>
          <div><span class="big">CQL</span><p>Cassandra’s query language reads like SQL, and Couchbase ships SQL++. “No SQL” was never the point.</p></div>
          <div><span class="big">Cluster</span><p>The design target: many commodity machines, not one large server.</p></div>
        </div>
      </div>
    </section>

    <!-- 04 TIMELINE -->
    <section class="chapter tl" id="origins" data-scene="strand" data-chapter="Origins">
      <div class="tl-sticky">
        <div class="tl-head">
          <div><p class="eyebrow">Origins</p></div>
          <p class="note">Keep scrolling. The track moves sideways while each milestone draws itself in.</p>
        </div>
        <div class="tl-track" id="tl-track">
          <div class="tl-intro">
            <span class="yr">1970<br />→ now</span>
            <p class="lede">Fifty years from one paper about tables to a cloud full of <em>clusters</em>.</p>
          </div>
          <div class="tl-rail">
            <div class="tl-line-bg"></div>
            <div class="tl-line" id="tl-line"></div>
            {timeline.map((it) => (
              <div class={`tl-item ${it.pos} ${it.key ? 'key' : ''}`}>
                <i class="stem"></i><i class="dot"></i>
                <div class="card">
                  <h3 class="when"><small>{it.m}</small>{it.y}</h3>
                  <p class="what"><b>{it.t}.</b> <Fragment set:html={it.d} /></p>
                </div>
              </div>
            ))}
            <div class="tl-end"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 RELATIONAL -->
    <section class="chapter rel" id="table" data-scene="grid" data-chapter="The table">
      <div class="rel-copy">
        <p class="eyebrow">Before NoSQL</p>
        <h2 class="h-display" data-split>For forty years, data lived in <em>tables.</em></h2>
        <p class="body-copy">A relational database stores data as <strong>rows in tables</strong>. You define the schema first: every row in a table has the same columns. A <strong>primary key</strong> identifies each row, a <strong>foreign key</strong> points at a row in another table, and a <strong>JOIN</strong> stitches them back together when you query with SQL.</p>
        <p class="body-copy">Changes run inside <strong>transactions</strong> that follow ACID. It is a brilliant design. It still runs most of the world’s banking, billing and booking.</p>
        <div class="acid">
          <div><b>A</b><span>Atomicity. A transaction happens completely or not at all.</span></div>
          <div><b>C</b><span>Consistency. Every commit leaves the data valid under its rules.</span></div>
          <div><b>I</b><span>Isolation. Concurrent transactions do not see each other’s half-done work.</span></div>
          <div><b>D</b><span>Durability. Once committed, a change survives a crash.</span></div>
        </div>
      </div>
      <div class="panel rel-tables">
        <div class="panel-head"><span>Sample schema · hover a student</span><span class="dots"><i></i><i></i><i></i></span></div>
        <div class="panel-body" style="display:grid;gap:16px">
          <div class="tbl-wrap">
            <table class="mini" id="t-students">
              <caption>students</caption>
              <thead><tr><th>reg_no (PK)</th><th>name</th><th>branch</th></tr></thead>
              <tbody>
                <tr data-reg="25BCE2449"><td>25BCE2449</td><td>Sai Aditya</td><td>BCE</td></tr>
                <tr data-reg="25BCE2542"><td>25BCE2542</td><td>Shrish</td><td>BCE</td></tr>
                <tr data-reg="25BCE2606"><td>25BCE2606</td><td>Sreya</td><td>BCE</td></tr>
                <tr data-reg="25BCE2635"><td>25BCE2635</td><td>Annette</td><td>BCE</td></tr>
              </tbody>
            </table>
          </div>
          <div class="tbl-wrap">
            <table class="mini" id="t-enrol">
              <caption>enrolments</caption>
              <thead><tr><th>reg_no (FK)</th><th>course</th><th>slot</th></tr></thead>
              <tbody>
                <tr data-reg="25BCE2449"><td>25BCE2449</td><td>Database Systems</td><td>A1</td></tr>
                <tr data-reg="25BCE2542"><td>25BCE2542</td><td>Database Systems</td><td>A1</td></tr>
                <tr data-reg="25BCE2542"><td>25BCE2542</td><td>Operating Systems</td><td>B2</td></tr>
                <tr data-reg="25BCE2606"><td>25BCE2606</td><td>Database Systems</td><td>A1</td></tr>
                <tr data-reg="25BCE2635"><td>25BCE2635</td><td>Discrete Mathematics</td><td>C1</td></tr>
                <tr data-reg="25BCE2635"><td>25BCE2635</td><td>Database Systems</td><td>A1</td></tr>
              </tbody>
            </table>
          </div>
          <pre class="term" id="rel-sql"><span class="kw">SELECT</span> s.name, e.course
<span class="kw">FROM</span> students s
<span class="kw">JOIN</span> enrolments e <span class="kw">ON</span> e.reg_no = s.reg_no
<span class="kw">WHERE</span> s.reg_no = <span class="str">'25BCE2542'</span>;</pre>
          <p class="note">Sample rows for illustration. The foreign key keeps enrolments pointing at real students, which is the relational model at work.</p>
        </div>
      </div>
    </section>

    <div class="marq" data-dir="1" aria-hidden="true"><div class="marq-in"><span><b>Part 01</b>The need</span><i>✦</i><span><b>Part 01</b>The need</span><i>✦</i><span><b>Part 01</b>The need</span><i>✦</i><span><b>Part 01</b>The need</span><i>✦</i></div></div>
    <!-- 06 WALL -->
    <section class="chapter wall" id="wall" data-scene="tower" data-chapter="The wall">
      <div class="wall-head">
        <p class="eyebrow">The need for NoSQL</p>
        <h2 class="h-display" data-split>Then the web <em>happened.</em></h2>
        <p class="lede">Billions of users, always online, generating data that rarely fits neat rows.</p>
        <p class="body-copy">Analyst Doug Laney described the problem in 2001 with three Vs. Each one pushes on a different assumption of the single-server relational design.</p>
      </div>
      <div class="vvv">
        <article class="panel vcard">
          <div class="viz viz-vol" aria-hidden="true">
            <i style="left:6%;height:30%"></i><i style="left:17%;height:45%;animation-delay:.2s"></i><i style="left:28%;height:38%;animation-delay:.4s"></i><i style="left:39%;height:60%;animation-delay:.6s"></i><i style="left:50%;height:52%;animation-delay:.8s"></i><i style="left:61%;height:74%;animation-delay:1s"></i><i style="left:72%;height:66%;animation-delay:1.2s"></i><i style="left:83%;height:92%;animation-delay:1.4s"></i>
          </div>
          <div class="txt"><h3>Volume</h3><p>Data grows past what one machine’s disks and memory can hold. Logs, clicks, messages and media pile up every second.</p></div>
        </article>
        <article class="panel vcard">
          <div class="viz viz-vel" aria-hidden="true">
            <i style="top:18%;animation-duration:1.1s"></i><i style="top:32%;animation-duration:.8s;animation-delay:.3s"></i><i style="top:46%;animation-duration:1.4s;animation-delay:.1s"></i><i style="top:60%;animation-duration:.7s;animation-delay:.5s"></i><i style="top:74%;animation-duration:1s;animation-delay:.2s"></i><i style="top:25%;animation-duration:.9s;animation-delay:.6s;background:var(--amber)"></i><i style="top:67%;animation-duration:1.2s;animation-delay:.8s;background:var(--amber)"></i>
          </div>
          <div class="txt"><h3>Velocity</h3><p>Writes arrive as a constant stream and reads must answer in milliseconds. A queue of locked rows becomes a traffic jam.</p></div>
        </article>
        <article class="panel vcard">
          <div class="viz viz-var" aria-hidden="true">
            <i style="left:12%;top:22%;width:34px;height:34px;background:var(--amber)"></i><i style="left:40%;top:30%;width:40px;height:40px;border-radius:50%;background:var(--ice);animation-delay:.4s"></i><i style="left:70%;top:18%;width:0;height:0;border-left:22px solid transparent;border-right:22px solid transparent;border-bottom:38px solid var(--ivory);animation-delay:.8s"></i><i style="left:22%;top:62%;width:70px;height:10px;background:#d8c7ff;animation-delay:.2s"></i><i style="left:60%;top:60%;width:28px;height:28px;border:2px solid var(--ok);animation-delay:1s"></i>
          </div>
          <div class="txt"><h3>Variety</h3><p>Profiles, JSON events, images, sensor readings and social links. One fixed schema cannot describe them all.</p></div>
        </article>
      </div>
    </section>

    <!-- 07 SCALE LAB -->
    <section class="chapter scale-lab" id="scale" data-scene="nodes" data-chapter="Scale lab">
      <div class="scale-sticky">
        <div class="scale-top">
          <div style="display:grid;gap:14px;max-width:640px">
            <p class="eyebrow">Scale up vs scale out</p>
            <h2 class="h-display" style="font-size:clamp(2.4rem,5vw,4.6rem)">Bigger box, or <em>more boxes?</em></h2>
            <p class="body-copy">Scrolling raises the traffic. You can also drag the slider. Watch what each strategy has to do to keep up.</p>
          </div>
          <div class="scale-ctl">
            <label for="traffic">Traffic <b id="traffic-out">1,000 req/s</b></label>
            <input type="range" id="traffic" min="0" max="1000" value="0" />
          </div>
        </div>
        <div class="scale-grid">
          <article class="panel scale-side">
            <h3>Scale up<small>Vertical · one server gets bigger</small></h3>
            <div class="stage-up"><div class="ceiling" id="ceiling">Largest single machine available</div><div class="big-box" id="big-box"><i class="led"></i><i></i><i></i><i></i></div></div>
            <div class="meters">
              <div>Machine<b id="up-size">4 vCPU</b></div>
              <div>Load<b id="up-load">10%</b><div class="meter-bar"><i id="up-bar"></i></div></div>
              <div>Cost index<b id="up-cost">1×</b></div>
            </div>
          </article>
          <article class="panel scale-side">
            <h3>Scale out<small>Horizontal · add commodity nodes</small></h3>
            <div class="stage-out" id="stage-out"></div>
            <div class="meters">
              <div>Nodes<b id="out-n">1</b></div>
              <div>Load per node<b id="out-load">10%</b><div class="meter-bar"><i id="out-bar"></i></div></div>
              <div>Cost index<b id="out-cost">1×</b></div>
            </div>
          </article>
        </div>
        <p class="note">Illustrative model, not a benchmark: one node handles about 10k req/s and costs 1×. Bigger machines cost disproportionately more, and there is always a largest one. Relational databases can be sharded too, but joins and transactions across machines get hard. Most NoSQL systems were designed for this from day one.</p>
      </div>
    </section>

    <!-- 08 ROWS VS DOCS -->
    <section class="chapter rvd" id="rows" data-scene="doc" data-chapter="Rows vs documents">
      <div class="cs-wrap" id="cs-wrap">
        <div class="cs-inner">
          <div class="cs-title" id="cs-title">
            <p class="eyebrow">Same data, two shapes</p>
            <h2 class="h-display">One order. <em>Four tables</em>, or one document.</h2>
            <p class="body-copy">Press fetch and count the work. Then change the customer’s city and see what the document model costs you.</p>
          </div>
          <div class="cs-card" id="cs-card">
            <div class="cs-screen">
              <div class="jx-bar">
                <span class="tag">Order #1042 · customer Asha</span>
                <div class="btn-row">
                  <button type="button" class="btn solid" id="jx-fetch">Fetch order</button>
                  <button type="button" class="btn" id="jx-city">Asha moves city</button>
                  <button type="button" class="btn" id="jx-reset">Reset</button>
                </div>
              </div>
              <div class="jx-grid">
                <div class="jx-side">
                  <h4><span>Relational · normalised</span><span class="tag sql">SQL</span></h4>
                  <div class="jx-tables">
                    <div class="jx-t" data-t="customers"><header><span>customers</span><span>PK id</span></header><ul><li data-r="c7">7 · Asha · Pune</li><li>8 · Ravi · Delhi</li></ul></div>
                    <div class="jx-t" data-t="orders"><header><span>orders</span><span>FK customer_id</span></header><ul><li data-r="o1042">1042 · cust 7 · 12 Oct</li><li>1043 · cust 8 · 12 Oct</li></ul></div>
                    <div class="jx-t" data-t="order_items"><header><span>order_items</span><span>FK order_id</span></header><ul><li data-r="i1">1042 · sku 31 · qty 2</li><li data-r="i2">1042 · sku 58 · qty 1</li></ul></div>
                    <div class="jx-t" data-t="products"><header><span>products</span><span>PK sku</span></header><ul><li data-r="p31">31 · Mug · ₹299</li><li data-r="p58">58 · Pen · ₹49</li></ul></div>
                  </div>
                  <pre class="term jx-sql" id="jx-sql"><span class="dim">-- waiting</span></pre>
                  <div class="jx-stats"><div>Tables touched<b id="jx-s-t">0</b></div><div>Joins<b id="jx-s-j">0</b></div></div>
                </div>
                <div class="jx-side">
                  <h4><span>Document · denormalised</span><span class="tag doc">Document</span></h4>
                  <pre class="jx-doc" id="jx-doc"></pre>
                  <pre class="term" id="jx-mq" style="min-height:3.4em"><span class="dim">// waiting</span></pre>
                  <div class="jx-stats"><div>Documents read<b id="jx-d-r">0</b></div><div>Docs to update on move<b id="jx-d-u">0</b></div></div>
                </div>
              </div>
              <div class="jx-foot note" id="jx-note">Normalised data stores each fact once and rebuilds the picture with joins. Denormalised documents store the picture ready-made, so reads are cheap and some facts get copied.</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="marq" data-dir="-1" aria-hidden="true"><div class="marq-in"><span><b>Part 02</b>Characteristics</span><i>✦</i><span><b>Part 02</b>Characteristics</span><i>✦</i><span><b>Part 02</b>Characteristics</span><i>✦</i><span><b>Part 02</b>Characteristics</span><i>✦</i></div></div>
    <!-- 09 SCHEMA -->
    <section class="chapter schema" id="schema" data-chapter="Schema">
      <div class="schema-head">
        <div style="display:grid;gap:20px">
          <p class="eyebrow">Characteristic · flexible schema</p>
          <h2 class="h-display" data-split>Schema on write vs <em>schema on read.</em></h2>
        </div>
        <div style="display:grid;gap:14px">
          <p class="body-copy">A relational table checks every row against its schema when you write it. A document store accepts each document as it is, and your application makes sense of the shape when it reads.</p>
          <p class="body-copy">Flexible does not mean lawless. MongoDB, for example, can validate documents against a JSON Schema. The rules move closer to the code that owns the data.</p>
        </div>
      </div>
      <div class="schema-ctl">
        <span class="lab">A new feature needs a field:</span>
        <button type="button" class="btn" data-field="phone">+ phone</button>
        <button type="button" class="btn" data-field="tags">+ tags</button>
        <button type="button" class="btn" data-field="loyalty">+ loyalty_tier</button>
        <button type="button" class="btn" id="schema-reset">Reset</button>
      </div>
