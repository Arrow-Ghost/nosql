    <!-- 10 FAMILIES -->
    <section class="chapter fam" id="families" data-chapter="Four families">
      <i class="anchor" data-scene="kv" style="position:absolute;top:0"></i>
      <i class="anchor" data-scene="doc" style="position:absolute;top:24%"></i>
      <i class="anchor" data-scene="col" style="position:absolute;top:48%"></i>
      <i class="anchor" data-scene="graph" style="position:absolute;top:72%"></i>
      <div class="fam-sticky" id="fam-sticky">
        <div class="fam-left">
          <div class="fam-step on" data-step="0">
            <span class="idx">FAMILY 1 OF 4</span>
            <h2>Key<br />value</h2>
            <p class="lede">A giant, distributed dictionary.</p>
            <dl>
              <dt>Stores</dt><dd>An opaque value behind a unique key. The database never looks inside the value.</dd>
              <dt>Strength</dt><dd>The fastest possible lookup by key, and it partitions easily across machines.</dd>
              <dt>Watch out</dt><dd>You can only ask “give me the value for this key”. No querying by what is inside.</dd>
              <dt>Used for</dt><dd>Sessions, caches, shopping carts, counters, rate limits, leaderboards.</dd>
              <dt>Examples</dt><dd>Redis, Amazon DynamoDB, Riak KV</dd>
            </dl>
          </div>
          <div class="fam-step" data-step="1">
            <span class="idx">FAMILY 2 OF 4</span>
            <h2>Document</h2>
            <p class="lede">Self-describing records you can query by any field.</p>
            <dl>
              <dt>Stores</dt><dd>JSON-like documents (BSON in MongoDB) with nested objects and arrays, grouped into collections.</dd>
              <dt>Strength</dt><dd>One document mirrors one object in your code. Rich queries and indexes on fields.</dd>
              <dt>Watch out</dt><dd>Relationships across documents are awkward. Copied data must be kept in sync.</dd>
              <dt>Used for</dt><dd>Product catalogues, user profiles, content management, mobile app backends.</dd>
              <dt>Examples</dt><dd>MongoDB, Couchbase, CouchDB, Firestore</dd>
            </dl>
          </div>
          <div class="fam-step" data-step="2">
            <span class="idx">FAMILY 3 OF 4</span>
            <h2>Wide<br />column</h2>
            <p class="lede">Rows grouped by partition, sorted for fast range reads.</p>
            <dl>
              <dt>Stores</dt><dd>Rows inside partitions. The partition key decides which node holds the data; clustering columns sort rows within it. Rows can have different columns.</dd>
              <dt>Strength</dt><dd>Enormous write throughput and fast reads of a slice, such as “the last hour for sensor 17”.</dd>
              <dt>Watch out</dt><dd>You model tables around your queries up front. Ad hoc queries are limited.</dd>
              <dt>Used for</dt><dd>Time series, IoT telemetry, event logs, messaging history.</dd>
              <dt>Examples</dt><dd>Apache Cassandra, HBase, ScyllaDB, Google Bigtable</dd>
            </dl>
          </div>
          <div class="fam-step" data-step="3">
            <span class="idx">FAMILY 4 OF 4</span>
            <h2>Graph</h2>
            <p class="lede">Relationships are first-class data.</p>
            <dl>
              <dt>Stores</dt><dd>Nodes (things) and edges (relationships), both carrying properties.</dd>
              <dt>Strength</dt><dd>Following connections hop by hop stays fast. There are no expensive multi-way joins.</dd>
              <dt>Watch out</dt><dd>Harder to spread one big graph across machines. Not built for bulk aggregates.</dd>
              <dt>Used for</dt><dd>Social networks, recommendations, fraud rings, knowledge graphs, routing.</dd>
              <dt>Examples</dt><dd>Neo4j, Amazon Neptune, ArangoDB</dd>
            </dl>
          </div>
          <div class="fam-progress" id="fam-progress"><i class="on"></i><i></i><i></i><i></i></div>
        </div>
        <div class="fam-right">
          <!-- KV -->
          <div class="fam-demo panel on" data-demo="0">
            <div class="panel-head"><span>redis-style console · key-value</span><span class="tag kv">Key-value</span></div>
